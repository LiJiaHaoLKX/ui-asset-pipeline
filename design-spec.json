{
  "name": "Playmate 清爽游戏陪玩 H5 设计系统",
  "version": "1.1-clean-ios",
  "scope": [
    "首页",
    "陪玩师发现与筛选",
    "陪玩师详情",
    "游戏选择",
    "服务套餐与预约",
    "订单确认与支付",
    "聊天与语音房",
    "评价与订单完成",
    "优惠券",
    "消息通知",
    "个人中心",
    "客服与反馈"
  ],
  "canvas": {
    "width": 752,
    "height": 1344
  },
  "designPrinciples": [
    "白色为主，使用连续背景、清晰层级和充足留白，避免每个信息区都被卡片包裹。",
    "采用清爽、轻量、圆润的 iOS 风格，使用细边框、柔和阴影和明确文字层级。",
    "蓝色用于主要行动、选中、在线、可预约和完成状态，不使用绿色。",
    "浅紫和蓝紫渐变只用于活动横幅、游戏封面遮罩或重点入口，不使用深紫色作为背景、主按钮或主要文字。",
    "每个操作区域只保留一个主操作，关键行为使用明确动词，例如预约陪玩、立即下单、进入语音房。",
    "陪玩师、游戏、价格、时长、评分和可预约状态优先可扫描展示。",
    "内容过长时自然换行，不通过过度缩小字号容纳文字。",
    "游戏氛围通过头像、真实游戏封面和少量低饱和渐变表达，界面本身保持可信、清洁和易读。",
    "不使用夸张胜率、虚假等级或绝对化承诺诱导消费。"
  ],
  "colors": {
    "background": {
      "page": "#F7F9FC",
      "primary": "#FFFFFF",
      "subtle": "#F1F5FA",
      "raised": "#FFFFFF",
      "selected": "#EAF2FF",
      "disabled": "#F2F4F7",
      "overlay": "#18223099"
    },
    "text": {
      "primary": "#182230",
      "secondary": "#566274",
      "tertiary": "#667386",
      "inverse": "#FFFFFF",
      "disabled": "#A8B1BF",
      "link": "#2463C7"
    },
    "action": {
      "primary": "#2F6FE4",
      "primaryHover": "#2860C6",
      "primaryPressed": "#204C9D",
      "primaryDisabled": "#B9CBEA",
      "secondary": "#EAF2FF",
      "secondaryHover": "#DCEAFF",
      "secondaryPressed": "#C9DDFB",
      "focusRing": "#2F6FE4"
    },
    "accent": {
      "sky": "#65B8F4",
      "skySoft": "#EAF7FF",
      "violet": "#8276C7",
      "violetSoft": "#F1EFFF",
      "warm": "#F3B45F",
      "warmSoft": "#FFF5E5",
      "gradientStart": "#6DBAF5",
      "gradientEnd": "#8075D0"
    },
    "border": {
      "default": "#DFE5EE",
      "strong": "#8491A3",
      "focus": "#2F6FE4",
      "disabled": "#E6EAF0"
    },
    "states": {
      "success": "#2463C7",
      "successBackground": "#EAF2FF",
      "warning": "#9A651A",
      "warningBackground": "#FFF4DF",
      "error": "#C7464D",
      "errorPressed": "#A93A40",
      "errorBackground": "#FDEEEF",
      "info": "#426C9D",
      "infoBackground": "#EAF1F8",
      "online": "#2463C7",
      "busy": "#9A651A",
      "offline": "#667386"
    },
    "colorRules": [
      "所有界面、图标、图表和装饰不得使用绿色或偏绿灰色。",
      "禁止使用深紫色作为页面背景、主按钮或主要文字；紫色只作为少量辅助色。",
      "蓝色不应铺满整屏，仅用于行动、链接、选中、在线和可预约状态。",
      "蓝色到浅紫色渐变仅用于活动横幅、游戏封面遮罩或重点入口，渐变角度保持柔和，不用于大面积页面背景。",
      "暖黄色只用于优惠、限时提示和轻量强调，不替代主要操作色。",
      "所有组件必须引用语义令牌，禁止添加未定义的局部品牌色。",
      "错误、成功、在线、离线、已选和优惠状态必须同时使用文字、图标、形状或位置表达，不能只依赖颜色。"
    ]
  },
  "typography": {
    "fontFamilies": {
      "primary": "PingFang SC, -apple-system, BlinkMacSystemFont, Microsoft YaHei, Arial, sans-serif",
      "numeric": "SF Pro Rounded, DIN Alternate, Arial, sans-serif"
    },
    "sizes": {
      "display": 52,
      "pageTitle": 40,
      "title": 34,
      "sectionTitle": 30,
      "cardTitle": 28,
      "bodyLarge": 28,
      "body": 26,
      "label": 24,
      "caption": 22,
      "micro": 20
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "display": 68,
      "pageTitle": 54,
      "title": 48,
      "sectionTitle": 42,
      "cardTitle": 40,
      "bodyLarge": 42,
      "body": 40,
      "label": 34,
      "caption": 32,
      "micro": 28
    },
    "letterSpacing": 0,
    "rules": [
      "标题使用 600 或 700，正文默认使用 400。",
      "陪玩师名称、游戏名称和价格可以使用 600，避免所有文字都使用粗体。",
      "价格、时长、订单编号和日期使用 numeric 字体。",
      "紧凑组件内最多使用两种字号和两种字重。",
      "micro 只用于非关键辅助信息，不用于错误、支付、价格或服务状态。",
      "标题左对齐，避免超大展示字压缩实际操作区域。",
      "文字必须支持自然换行，核心价格、日期、状态和操作文案不得截断。"
    ]
  },
