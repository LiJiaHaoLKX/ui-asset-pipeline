  "assetRules": {
    "raster": [
      "真实陪玩师头像、游戏封面和复杂插画使用 WebP；AVIF 只有在宿主支持并提供回退时使用。",
      "图片至少满足实际 CSS 显示尺寸的 2 倍像素密度；136 design-px 头像至少使用 272 像素源图。",
      "头像使用自然、清晰、不过度磨皮的照片或统一人物占位图，避免绿色服饰与大面积绿色背景。",
      "游戏封面应展示真实游戏氛围、角色或场景，避免模糊、过暗、过度裁切和纯装饰图片。",
      "营销插画使用简洁的游戏手柄、耳机、语音或组队元素，避免夸张表情和视觉噪音。",
      "图片避免大面积强渐变、噪点和过度模糊；渐变只作为轻量遮罩或背景辅助。"
    ],
    "codeRendered": [
      "所有文字、按钮、价格、标签、表单、状态、导航、评分、筛选条件和订单信息均由代码渲染。",
      "图标使用统一矢量组件；简单几何、分割线、评分符号和状态标识不导出位图。",
      "在线、忙碌、离线、已预约和订单状态必须使用可读文本或可访问标签。"
    ],
    "bakedText": [
      "陪玩师昵称、游戏名称、段位、价格、时间、评分、订单状态和操作文案不得烘焙进图片。",
      "只有品牌授权标志或原始游戏官方素材中的不可分离文字可以保留；有意义的图片文字必须提供等效替代文本。"
    ],
    "iconStyle": {
      "family": "统一 iOS 风格圆润线性图标",
      "strokeWidth": 2,
      "defaultSize": 40,
      "smallSize": 32,
      "filledUsage": "仅激活导航、收藏、已选和在线状态使用填充图标。",
      "preferredLibrary": "项目已有图标库或 Lucide 风格图标",
      "rules": [
