    "topBarHeight": 88,
    "bottomNavigationHeight": 108,
    "minimumTouchTarget": 88,
    "listItemMinimumHeight": 112,
    "contentMaxWidth": 752,
    "fixedBottomActionReservedSpace": 142,
    "rules": [
      "卡片用于陪玩师、游戏、订单、套餐和消息等可独立操作的信息组。",
      "连续内容区优先使用白色背景，分组可使用浅蓝灰色背景带区分。",
      "固定底部操作必须预留组件高度和实际底部安全区，至少预留 142 design-px。",
      "固定底部 tabbar 使用白色背景和轻柔向上阴影，不使用上边框。",
      "避免卡片套卡片，卡片内部使用间距、分割线或轻背景组织信息。",
      "活动横幅和游戏封面可以使用圆角图片，但不把所有内容都设计成浮动面板。"
    ]
  },
